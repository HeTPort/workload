#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) buffer OutputBuffer {
    uint data[];
} out_buf;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint iterations;
    uint shader_id;
    uint texture_count;
    uint frame_index;
    uint reserved0;
    uint reserved1;
} pc;

uint hash_u32(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

uint pack_rgba(vec4 c) {
    uint r = uint(clamp(c.r, 0.0, 1.0) * 255.0);
    uint g = uint(clamp(c.g, 0.0, 1.0) * 255.0);
    uint b = uint(clamp(c.b, 0.0, 1.0) * 255.0);
    uint a = uint(clamp(c.a, 0.0, 1.0) * 255.0);

    return r | (g << 8) | (b << 16) | (a << 24);
}

vec4 workload_alu(vec2 uv) {
    vec4 x = vec4(uv, 0.37, 1.0);

    for (uint i = 0u; i < pc.iterations; ++i) {
        x = x * vec4(1.00013, 0.99991, 1.00007, 0.99989)
              + vec4(0.00031, 0.00017, 0.00023, 0.00029);
        x = fract(x * 1.61803398875 + x.yzwx);
    }

    return vec4(x.rgb, 1.0);
}

vec4 workload_sfu(vec2 uv) {
    vec2 p = uv * 6.2831853;
    float x = p.x + 0.17;
    float y = p.y + 0.31;

    for (uint i = 0u; i < pc.iterations; ++i) {
        x = sin(x) + cos(y) + 0.001;
        y = cos(y) - sin(x) + 0.002;
    }

    return vec4(fract(abs(x)), fract(abs(y)), fract(abs(x + y)), 1.0);
}

vec4 workload_texture_like(uvec2 gid, vec2 uv) {
    vec4 c = vec4(0.0);
    uint count = max(pc.texture_count, 1u);

    for (uint i = 0u; i < pc.iterations; ++i) {
        uint h = hash_u32(
            gid.x * 73856093u ^
            gid.y * 19349663u ^
            i * 83492791u ^
            pc.frame_index * 2654435761u
        );

        vec3 v = vec3(
            float((h >> 0) & 255u),
            float((h >> 8) & 255u),
            float((h >> 16) & 255u)
        ) / 255.0;

        for (uint t = 0u; t < count; ++t) {
            uint ht = hash_u32(h ^ t * 2246822519u);

            c += vec4(
                float((ht >> 0) & 255u) / 255.0,
                float((ht >> 8) & 255u) / 255.0,
                float((ht >> 16) & 255u) / 255.0,
                1.0
            ) * 0.5 + vec4(v, 1.0) * 0.5;
        }
    }

    c /= float(max(pc.iterations * count, 1u));
    return vec4(c.rgb, 1.0);
}

vec4 workload_fill(vec2 uv) {
    return vec4(uv.x, uv.y, fract(uv.x + uv.y), 1.0);
}

vec4 workload_mixed(uvec2 gid, vec2 uv) {
    vec4 x = vec4(uv, 0.37, 1.0);
    vec4 tex = vec4(0.0);
    uint count = max(pc.texture_count, 1u);

    for (uint i = 0u; i < pc.iterations; ++i) {
        x = x * vec4(1.00011, 0.99997, 1.00005, 0.99993)
              + vec4(0.00019, 0.00023, 0.00029, 0.00031);

        uint h = hash_u32(
            gid.x * 73856093u ^
            gid.y * 19349663u ^
            i * 83492791u ^
            pc.frame_index * 2654435761u
        );

        for (uint t = 0u; t < count; ++t) {
            uint ht = hash_u32(h ^ t * 2246822519u);

            tex += vec4(
                float((ht >> 0) & 255u) / 255.0,
                float((ht >> 8) & 255u) / 255.0,
                float((ht >> 16) & 255u) / 255.0,
                1.0
            );
        }

        x = fract(x + tex * 0.0007 + x.yzwx * 0.013);
    }

    vec3 rgb = fract(x.rgb + tex.rgb / float(max(pc.iterations * count, 1u)));
    return vec4(rgb, 1.0);
}

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;

    if (gid.x >= pc.width || gid.y >= pc.height) {
        return;
    }

    uint index = gid.y * pc.width + gid.x;
    vec2 uv = vec2(gid) / vec2(max(pc.width, 1u), max(pc.height, 1u));

    vec4 color;

    if (pc.shader_id == 1u) {
        color = workload_alu(uv);
    } else if (pc.shader_id == 2u) {
        color = workload_sfu(uv);
    } else if (pc.shader_id == 3u) {
        color = workload_texture_like(gid, uv);
    } else if (pc.shader_id == 4u) {
        color = workload_fill(uv);
    } else {
        color = workload_mixed(gid, uv);
    }

    out_buf.data[index] = pack_rgba(color);
}
