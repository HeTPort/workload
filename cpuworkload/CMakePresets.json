{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "desktop-release",
      "displayName": "Desktop Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CPU_AVS_STATIC_CXX_RUNTIME": "ON"
      }
    },
    {
      "name": "android-arm64-release",
      "displayName": "Android arm64-v8a Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_static",
        "CPU_AVS_STATIC_CXX_RUNTIME": "ON"
      }
    },
    {
      "name": "harmony-arm64-release",
      "displayName": "HarmonyOS arm64-v8a Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/harmony-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{OHOS_NDK_HOME}/build/cmake/ohos.toolchain.cmake",
        "OHOS_ARCH": "arm64-v8a",
        "OHOS_STL": "c++_static",
        "CPU_AVS_STATIC_CXX_RUNTIME": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "desktop-release", "configurePreset": "desktop-release" },
    { "name": "android-arm64-release", "configurePreset": "android-arm64-release" },
    { "name": "harmony-arm64-release", "configurePreset": "harmony-arm64-release" }
  ]
}
